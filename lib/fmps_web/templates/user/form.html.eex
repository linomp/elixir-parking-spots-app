<%= form_for @changeset, @action, fn f -> %>
  <%= if @changeset.action do %>
    <div class="alert alert-danger">
      <p>Oops, something went wrong! Please check the errors below.</p>
    </div>
  <% end %>

  <%= label f, :name %>
  <%= text_input f, :name, id: "name" %>
  <%= error_tag f, :name %>

  <%= label f, :email %>
  <%= text_input f, :email, id: "email" %>
  <%= error_tag f, :email %>

  <%= label f, :licence_number %>
  <%= text_input f, :licence_number, id: "licence_number" %>
  <%= error_tag f, :licence_number %>

  <%= label f, :password %>
  <%= text_input f, :password, id: "password" %>
  <%= error_tag f, :password %>

  <div>
    <%= submit "Register", id: "submit_register" %>
  </div>
<% end %>
