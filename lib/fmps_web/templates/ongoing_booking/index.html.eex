<%= if (@ongoingExists) do%>

  <hr>
  <h2>
    <%= "Ongoing #{if @booking.is_hourly do "hourly" else "real-time" end} booking at #{@address}" %>
  </h2>

  <%= if !(@booking.is_hourly) do%>
    <ul>
      <li>Start: <%= @booking.start_time %></li>
    </ul>

    <%= form_tag("/ongoing-booking", method: :post) %>
      <button id="pay-real-time" type="submit">Pay</button>
    </form>
  <% end %>

  <%= if (@booking.is_hourly) do%>
    <ul>
      <li>Start: <%= @booking.start_time %></li>
      <li>End: <%= @booking.leaving_time %></li>
      <li>Total Price: <%= @priceIfHourly %></li>
    </ul>
    <%= form_tag("/booking/#{@booking.id}/edit", address: @address, method: :get) %>
      <button id="extend-hourly" type="submit">Extend</button>
    </form>
  <% end %>

<% else %>

    <hr>
    <h2>
      There's currently no ongoing booking
    </h2>

<% end %>
