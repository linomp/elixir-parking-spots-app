
<h1>Type your destination</h1>

 <%= form_tag("/search", method: :post) %>
  <input name="address" type="text" id="address"/>
  <label for="leavingTime">Intended Leaving Time (optional):</label>
  <input name="leavingTime" type="text" placeholder="HH:MM" id="leavingTime"/>
  <br />
  <button id="search">Search</button>
</form>


<br/>

  <%= if Enum.count(@parkingSpots) == 0 do%>

    There are no available parking spots near your destination.

  <% else %>

    <table class="table">
      <thead>
        <tr>
          <th>Address</th>
          <th>Zone</th>
          <th>Hourly Rate (€)</th>
          <th>Real-Time Rate (ct. / 5 mins.)</th>
          <%= if @processedResults==true do%>
              <th>Distance (m)</th>
              <th>Walking Time (mins.)</th>
              <th>Price (Hourly)</th>
              <th>Price (Real-Time)</th>
          <% end %>
          
          <th>Book</th>

        </tr>
      </thead>
      <tbody>

      <%= if @processedResults==true do%>
        <%= for spotTuple <- @parkingSpots do %>
            <tr class="parking-result">
              <td><%= elem(spotTuple, 0).address %></td>
              <td><%= elem(spotTuple, 0).parking_category.name %></td>
              <td><%= elem(spotTuple, 0).parking_category.hourly_rate %></td>
              <td><%= elem(spotTuple, 0).parking_category.real_time_rate %></td>
              <td><%= (elem(spotTuple, 1).travelDistance)*1000 %></td>
              <td><%= round(elem(spotTuple, 1).travelDuration) %></td>
              <td class="estimated-for-hour"> <%= elem(spotTuple, 2).priceIfHour %></td>
              <td class="estimated-for-real-time"> <%= elem(spotTuple, 2).priceIfRealTime %> </td>
              <td><%= button "Book", method: :get, to: Routes.booking_path(@conn, :show, elem(spotTuple, 0)), id: elem(spotTuple, 0).address %></td>
            </tr>
        <% end %>
      <% else %>
        <%= for spot <- @parkingSpots do %>
            <tr class="parking-result">
              <td><%= spot.address %></td>
              <td><%= spot.parking_category.name %></td>
              <td><%= spot.parking_category.hourly_rate %></td>
              <td><%= spot.parking_category.real_time_rate %></td>
              <td><%= button "Book", method: :get, to: Routes.booking_path(@conn, :show, spot), id: spot.address %></td>
            </tr>
        <% end %>
      <% end %>

      </tbody>
    </table>


  <% end %>
