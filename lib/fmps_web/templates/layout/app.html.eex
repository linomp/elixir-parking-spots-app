<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Fmps · Phoenix Framework</title>
    <link rel="stylesheet" href="<%= Routes.static_path(@conn, "/css/app.css") %>"/>
    <script defer type="text/javascript" src="<%= Routes.static_path(@conn, "/js/app.js") %>"></script>
  </head>
  <body>
      <header class="header">
        <ol class="breadcrumb pull-right">
          <%= if Fmps.Authentication.load_current_user(@conn) do %>
          <li>Hello <%= Fmps.Authentication.load_current_user(@conn).name %></li>
          <li><%= link "Log out", to: Routes.session_path(@conn, :delete, Fmps.Authentication.load_current_user(@conn)), method: "delete", id: "submit_logout" %></li>
            <% else %>
          <li><%= link "Log in", to: Routes.session_path(@conn, :new) %></li>
          <li><%= link "Register", to: Routes.user_path(@conn, :new), id: "register_button" %></li>
          <% end %>
        </ol>
        <span class="logo"></span>
      </header>
    <main role="main" class="container">
      <p class="alert alert-info" role="alert"><%= get_flash(@conn, :info) %></p>
      <p class="alert alert-danger" role="alert"><%= get_flash(@conn, :error) %></p>
      <%= @inner_content %>
    </main>
  </body>
</html>
